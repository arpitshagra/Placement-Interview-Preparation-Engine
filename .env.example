# =============================================================================
# IntervIQ 2.0 — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.

# ── Supabase & PostgreSQL ─────────────────────────────────────────────────────
# Found in your Supabase Project Settings -> API:
SUPABASE_URL=https://your-project-ref.supabase.co
# Project API Key -> anon / public key (for public client interactions):
SUPABASE_KEY=your-supabase-anon-key
# Project API Key -> service_role key (required for administrative operations & auto-confirming users):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional direct PostgreSQL connection URL (e.g. from Database Settings -> Connection string -> URI):
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Groq LLM API ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# Optional Groq model override (default: openai/gpt-oss-120b with fallback models):
GROQ_MODEL=openai/gpt-oss-120b

# ── Flask App Secrets ────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-secret-key
PORT=5000
